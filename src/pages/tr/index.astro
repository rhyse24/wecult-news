---
import Base from '../../layouts/Base.astro'
import ArticleCard from '../../components/article/ArticleCard.astro'
import NewsletterHook from '../../components/ui/NewsletterHook.astro'
import AdSlot from '../../components/ui/AdSlot.astro'
import { t, getLocalizedPath } from '../../lib/i18n'
import { articles as mockArticles, getByLang } from '../../lib/articles'
import type { Lang } from '../../types'

const lang: Lang = 'tr'
const langArticles = getByLang(mockArticles, lang)
const articles = langArticles.length >= 3 ? langArticles : mockArticles

const sorted = [...articles].sort(
  (a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime()
)

const carouselArticles = sorted.slice(0, 3)
const gridArticles     = sorted
const trendingArticles = sorted.slice(0, 5)
const tickerTags       = [...new Set(mockArticles.flatMap(a => a.tags))].slice(0, 14)

const catColors: Record<string, string> = {
  games: 'var(--cat-games)', film: 'var(--cat-film)',
  tv: 'var(--cat-tv)', books: 'var(--cat-books)',
}
---

<Base title="Ana Sayfa" lang={lang}>
<div class="hp-page">

  <!-- ── Hero: carousel + latest sidebar ─── -->
  <div class="container">
    <div class="hp-hero">

      <div class="hp-hero-main">
        <div class="carousel" id="hero-carousel">
          {carouselArticles.map((a, i) => (
            <div class={`carousel-slide${i === 0 ? ' is-active' : ''}`} data-index={i}>
              <ArticleCard article={a} lang={lang} size="hero" />
            </div>
          ))}
          <div class="carousel-controls">
            <div class="carousel-dots">
              {carouselArticles.map((_, i) => (
                <button class={`carousel-dot${i === 0 ? ' is-active' : ''}`} data-index={i} aria-label={`Slayt ${i + 1}`}></button>
              ))}
            </div>
            <div class="carousel-arrows">
              <button class="carousel-arrow" id="prev-btn" aria-label="Önceki">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="carousel-arrow" id="next-btn" aria-label="Sonraki">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <aside class="hp-hero-sidebar">
        <div class="hs-label">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1l1.2 2.4L10 3.9l-2 1.95.47 2.75L6 7.4l-2.47 1.2L4 5.85 2 3.9l2.8-.5L6 1z" fill="#c9a84c"/></svg>
          Gündemde
        </div>
        <ol class="hs-trending-list">
          {trendingArticles.map(a => (
            <ArticleCard article={a} lang={lang} size="mini" />
          ))}
        </ol>
      </aside>

    </div>
  </div>

  <!-- ── Ticker strip ──────────────────────── -->
  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-inner">
      {tickerTags.map(tag => (
        <a href={getLocalizedPath(lang, `/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`)} class="ticker-tag">
          <span class="ticker-sep">✦</span>{tag}
        </a>
      ))}
      {tickerTags.map(tag => (
        <a href={getLocalizedPath(lang, `/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`)} class="ticker-tag" tabindex="-1">
          <span class="ticker-sep">✦</span>{tag}
        </a>
      ))}
    </div>
  </div>

  <!-- ── Main grid ────────────────────────── -->
  <div class="hp-body-section">
  <div class="hp-body-fade"></div>
  <div class="container">

    <div class="section-header">
      <div class="section-header-left">
        <h2 class="section-title">Tüm Haberler</h2>
        <p class="section-subtitle">AI tarafından derlenen eğlence haberleri</p>
      </div>
      <span class="story-count">{gridArticles.length} haber</span>
    </div>

    <div class="story-grid">
      {gridArticles.map((a, i) => {
        if (i === 0) return (
          <div class="story-lead" style={`--card-accent:${catColors[a.category]}`}>
            <ArticleCard article={a} lang={lang} size="featured" />
          </div>
        )
        if (i === 5) return (
          <Fragment>
            <AdSlot class="story-grid-ad" />
            <ArticleCard article={a} lang={lang} size="default" />
          </Fragment>
        )
        return <ArticleCard article={a} lang={lang} size="default" />
      })}
    </div>

    <AdSlot class="story-bottom-ad" />

    <NewsletterHook lang={lang} variant="default" />

  </div>
  </div>

</div>
</Base>

<script>
  const carousel = document.getElementById('hero-carousel')
  if (carousel) {
    const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide')
    const dots   = carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot')
    if (!slides.length) { /* no articles yet */ }
    else {
    let current = 0
    let timer: ReturnType<typeof setInterval>

    function goTo(n: number) {
      slides[current].classList.remove('is-active')
      dots[current]?.classList.remove('is-active')
      current = ((n % slides.length) + slides.length) % slides.length
      slides[current].classList.add('is-active')
      dots[current]?.classList.add('is-active')
    }

    const start = () => { timer = setInterval(() => goTo(current + 1), 5500) }
    const stop  = () => clearInterval(timer)

    dots.forEach(d => d.addEventListener('click', () => { stop(); goTo(+d.dataset.index!); start() }))
    document.getElementById('prev-btn')?.addEventListener('click', () => { stop(); goTo(current - 1); start() })
    document.getElementById('next-btn')?.addEventListener('click', () => { stop(); goTo(current + 1); start() })
    carousel.addEventListener('mouseenter', stop)
    carousel.addEventListener('mouseleave', start)
    start()
    } // end slides.length check
  }
</script>

<style is:global>
  .hp-page { padding-bottom: 0; }

  /* ── Hero ─────────────────────────────────── */
  .hp-hero {
    display: grid;
    grid-template-columns: 1fr 272px;
    gap: 1.25rem;
    padding-top: 2rem;
    margin-bottom: 2.5rem;
    align-items: start;
    position: relative;
  }
  .hp-hero::before {
    content: '';
    position: absolute;
    top: -60px; left: -10%; right: -10%;
    height: 220px;
    background: radial-gradient(ellipse at 50% 0%, rgba(201,168,76,0.07) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-hero-main { min-width: 0; }

  .hp-hero-sidebar {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border-subtle);
    padding-left: 1.25rem;
    min-width: 0;
  }
  .hs-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.7;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 15%, var(--border-subtle));
    margin-bottom: 0.125rem;
  }
  .hs-trending-list {
    counter-reset: trending-counter;
    list-style: none;
    padding: 0; margin: 0;
  }

  /* ── Carousel ─────────────────────────────── */
  .carousel {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 16/9;
    background: var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--border-subtle));
    box-shadow:
      0 4px 32px rgba(0,0,0,0.65),
      0 16px 56px rgba(0,0,0,0.4);
  }
  .carousel-slide {
    position: absolute; inset: 0;
    opacity: 0; transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .carousel-slide.is-active { opacity: 1; pointer-events: auto; }
  .carousel-slide .hero-card {
    border-radius: 0; aspect-ratio: unset;
    height: 100%; width: 100%;
  }
  .carousel-controls {
    position: absolute;
    bottom: 1.125rem; left: 1.5rem; right: 1.5rem;
    display: flex; align-items: center; justify-content: space-between;
    pointer-events: none; z-index: 10;
  }
  .carousel-dots { display: flex; gap: 5px; pointer-events: auto; }
  .carousel-dot {
    width: 22px; height: 4px; border-radius: 2px;
    background: rgba(255,255,255,0.4);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.25s, width 0.25s;
  }
  .carousel-dot.is-active { background: #fff; width: 36px; }
  .carousel-arrows { display: flex; gap: 0.375rem; pointer-events: auto; }
  .carousel-arrow {
    width: 30px; height: 30px; border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(6px);
    transition: background 0.15s;
  }
  .carousel-arrow:hover { background: rgba(255,255,255,0.24); }

  /* ── Ticker ───────────────────────────────── */
  .ticker-wrap {
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--accent) 12%, var(--border-subtle));
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 12%, var(--border-subtle));
    height: 32px;
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--accent) 3%, var(--bg));
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }
  .ticker-wrap:hover .ticker-inner { animation-play-state: paused; }
  .ticker-inner {
    display: flex;
    animation: ticker-scroll 40s linear infinite;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ticker-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0 1.375rem;
    transition: color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ticker-tag:hover { color: var(--text-secondary); }
  .ticker-sep { color: var(--accent); font-size: 0.4375rem; opacity: 0.6; }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Body section wrapper ────────────────── */
  .hp-body-section {
    background: var(--bg);
    border-top: none;
    padding-top: 3rem;
    padding-bottom: 4.5rem;
    margin-top: 0;
    position: relative;
  }
  .hp-body-section::before {
    content: '';
    position: absolute;
    top: -40px; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .hp-body-fade {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 100px;
    background: linear-gradient(to bottom, rgba(201,168,76,0.04) 0%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }
  .section-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .section-subtitle {
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  .hp-body-section .section-title {
    font-size: 1rem;
  }

  /* ── Body grid ────────────────────────────── */
  .story-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .story-lead {
    grid-column: 1 / -1;
  }
  .story-lead .featured-card {
    min-height: 280px;
    max-height: 320px;
    border-radius: var(--radius-xl);
  }
  .story-lead .featured-img-wrap {
    width: 48%;
  }
  .story-lead .featured-title {
    font-size: 1.375rem;
    -webkit-line-clamp: 3;
    font-family: var(--font-serif);
  }
  .story-lead .featured-excerpt {
    -webkit-line-clamp: 3;
    font-size: 0.9375rem;
  }
  .story-grid > :nth-child(6) { grid-column: span 2; }
  .story-grid > :nth-child(6) .default-img-wrap { aspect-ratio: 21/9; }
  .story-count {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 2px 9px;
    border-radius: 20px;
  }

  /* ── Shared ───────────────────────────────── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  /* ── Mobile ───────────────────────────────── */
  @media (max-width: 768px) {
    .hp-hero { grid-template-columns: 1fr !important; }
    .hp-hero-sidebar { display: none !important; }
    .story-grid { grid-template-columns: 1fr !important; }
    .story-lead { grid-column: 1 / -1 !important; }
    .story-grid > :nth-child(6) { grid-column: 1 / -1 !important; }
    .story-grid > :nth-child(6) .default-img-wrap { aspect-ratio: 16/9 !important; }
    .featured-card { flex-direction: column; max-height: none; }
    .featured-img-wrap { width: 100%; aspect-ratio: 16/9; }
  }
  @media (min-width: 480px) and (max-width: 768px) {
    .story-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (min-width: 768px) and (max-width: 1024px) {
    .story-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>
