---
import Base from '../../layouts/Base.astro'
import type { Lang } from '../../types'

const lang: Lang = 'tr'
---

<Base title="404 — Sayfa Bulunamadı" lang={lang}>
  <div class="nf-page">
    <div class="container">
      <div class="nf-inner">

        <div class="nf-eyebrow">
          <span class="nf-code">404</span>
          <span class="nf-sep">·</span>
          <span class="nf-label">Sayfa bulunamadı</span>
        </div>

        <h1 class="nf-title">Akışta kayboldu mu?</h1>
        <p class="nf-desc">
          Aradığın makale, kategori veya sayfa mevcut değil ya da taşınmış olabilir.
          Bunlardan birini dene:
        </p>

        <div class="nf-cats">
          <a href="/tr/games" class="nf-cat" style="--c:var(--cat-games)">
            <span class="nf-cat-icon">🎮</span>
            <span>Oyun</span>
          </a>
          <a href="/tr/film" class="nf-cat" style="--c:var(--cat-film)">
            <span class="nf-cat-icon">🎬</span>
            <span>Film</span>
          </a>
          <a href="/tr/tv" class="nf-cat" style="--c:var(--cat-tv)">
            <span class="nf-cat-icon">📺</span>
            <span>Dizi</span>
          </a>
          <a href="/tr/books" class="nf-cat" style="--c:var(--cat-books)">
            <span class="nf-cat-icon">📚</span>
            <span>Kitap</span>
          </a>
        </div>

        <a href="/tr" class="nf-home-btn">← Ana Sayfaya Dön</a>

      </div>
    </div>
  </div>
</Base>
