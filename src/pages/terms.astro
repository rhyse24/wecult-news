---
import Base from '../layouts/Base.astro'
import type { Lang } from '../types'

const lang: Lang = 'en'
---

<Base title="Terms of Use — WeCult News" lang={lang}>
  <div class="legal-page">
    <div class="container">
      <div class="legal-inner">
        <div class="legal-eyebrow">Terms of Use</div>
        <h1 class="legal-title">Terms of Use</h1>
        <p class="legal-meta">Last updated: May 2025</p>

        <div class="legal-body">
          <p>By accessing <strong>news.wecult.app</strong>, you agree to these terms. WeCult News is operated by WeCult.</p>

          <h2>Content</h2>
          <p>WeCult News publishes AI-curated summaries and analysis of entertainment news. All original article content remains the property of the respective sources. We link to original sources and do not reproduce full articles without permission.</p>

          <h2>Use of the Site</h2>
          <p>You may use WeCult News for personal, non-commercial purposes. You may not scrape, redistribute, or republish content from this site without written permission.</p>

          <h2>Accuracy</h2>
          <p>Content on WeCult News is generated and curated with the assistance of AI. While we strive for accuracy, we make no warranties about the completeness or reliability of any information. Always verify important information with original sources.</p>

          <h2>Third-Party Links</h2>
          <p>WeCult News links to third-party websites. We are not responsible for their content or practices.</p>

          <h2>WeCult Platform Terms</h2>
          <p>For the full terms of service of the WeCult platform and mobile application, visit <a href="https://wecult.app" target="_blank" rel="noopener noreferrer">wecult.app</a>.</p>

          <h2>Contact</h2>
          <p>For questions about these terms, contact us through <a href="https://wecult.app" target="_blank" rel="noopener noreferrer">wecult.app</a>.</p>
        </div>

        <a href="/" class="legal-back">← Back to Home</a>
      </div>
    </div>
  </div>
</Base>
