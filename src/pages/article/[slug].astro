---
import Base from '../../layouts/Base.astro'
import ArticleCard from '../../components/article/ArticleCard.astro'
import WeCultCTA from '../../components/ui/WeCultCTA.astro'
import { t, getLocalizedPath } from '../../lib/i18n'
import { articles as mockArticles, getRelated } from '../../lib/articles'
import type { Lang } from '../../types'

export async function getStaticPaths() {
  return mockArticles.map(a => ({ params: { slug: a.slug } }))
}

const { slug } = Astro.params
const lang: Lang = 'en'

const article = mockArticles.find(a => a.slug === slug) ?? mockArticles[0]
const tr = article.translations[lang] ?? article.translations['en']
const related = getRelated(mockArticles, article, 3)

const catColors: Record<string, string> = {
  games: 'var(--cat-games)', film: 'var(--cat-film)',
  tv: 'var(--cat-tv)', books: 'var(--cat-books)',
}
const color = catColors[article.category]

const typeLabel: Record<string, string> = {
  news: 'News', review: 'Review', feature: 'Feature', opinion: 'Opinion', guide: 'Guide',
}
const typeColor: Record<string, string> = {
  news: 'var(--text-muted)', review: '#f59e0b', feature: '#818cf8', opinion: '#f472b6', guide: '#34d399',
}

const date = new Date(article.published_at).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
})
const timeAgo = (() => {
  const h = Math.floor((Date.now() - new Date(article.published_at).getTime()) / 3600000)
  if (h < 1) return 'Just now'
  if (h < 24) return `${h}h ago`
  return `${Math.floor(h / 24)}d ago`
})()

// Next article for sticky bar
const currentIndex = mockArticles.findIndex(a => a.slug === article.slug)
const nextArticle = mockArticles[(currentIndex + 1) % mockArticles.length]
const nextTr = nextArticle.translations[lang] ?? nextArticle.translations['en']
const nextColor = { games:'var(--cat-games)', film:'var(--cat-film)', tv:'var(--cat-tv)', books:'var(--cat-books)' }[nextArticle.category]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const nextHref = `${base}/${lang !== 'en' ? lang + '/' : ''}article/${nextArticle.slug}`

const pageUrl = `https://wecult.news/article/${article.slug}`
const shareTitle = encodeURIComponent(tr?.title ?? '')
const shareUrl = encodeURIComponent(pageUrl)
---

<Base title={tr?.title ?? ''} lang={lang} ogImage={article.cover_image ?? undefined}>

  <!-- Scroll progress bar (category color) -->
  <div id="scroll-progress" class="scroll-progress-bar" style={`--progress-color:${color}`}></div>

  <div class="article-page">

    <!-- Hero image -->
    {article.cover_image && (
      <div class="article-hero">
        <img src={article.cover_image} alt={tr?.title} />
        <div class="article-hero-overlay"></div>
      </div>
    )}

    <div class="container">
      <div class="article-layout">

        <!-- Main content -->
        <article class="article-body">

          <!-- Breadcrumb / meta top -->
          <div class="article-meta-top">
            <a href={getLocalizedPath(lang, `/${article.category}`)} class="cat-pill-link" style={`color:${color}; background:color-mix(in srgb, ${color} 10%, transparent); border-color:color-mix(in srgb, ${color} 22%, transparent)`}>
              {t(lang, `nav.${article.category}`)}
            </a>
            <span class="meta-dot">·</span>
            <span class="art-type-label" style={`color:${typeColor[article.article_type]}`}>
              {typeLabel[article.article_type]}
            </span>
            <span class="meta-dot">·</span>
            <span class="meta-text">{date}</span>
            <span class="meta-dot">·</span>
            <span class="meta-text">{timeAgo}</span>
          </div>

          <!-- Title -->
          <h1 class="article-title">{tr?.title}</h1>

          <!-- Byline -->
          <div class="article-byline">
            <div class="source-avatar">{article.source_name.charAt(0)}</div>
            <span class="source-name">{article.source_name}</span>
            <span class="byline-sep">·</span>
            <svg class="clock-icon" width="13" height="13" viewBox="0 0 13 13" fill="none">
              <circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M6.5 3.5v3l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <span class="read-time">{article.reading_time_minutes} min read</span>
          </div>

          <!-- Social share buttons -->
          <div class="share-bar">
            <span class="share-label">Share</span>
            <a href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
               target="_blank" rel="noopener noreferrer" class="share-btn share-x" aria-label="Share on X">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
                <path d="M10.93 1.5H12.7L8.84 5.93 13.4 12.5H9.82L7.05 8.78 3.87 12.5H2.1L6.24 7.74 1.86 1.5H5.53L8.04 4.88 10.93 1.5ZM10.3 11.43H11.28L5.01 2.5H3.96L10.3 11.43Z"/>
              </svg>
            </a>
            <a href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareTitle}`}
               target="_blank" rel="noopener noreferrer" class="share-btn share-reddit" aria-label="Share on Reddit">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
                <circle cx="7" cy="7" r="6.25" stroke="currentColor" stroke-width="1.3" fill="none"/>
                <path d="M10.7 7a.9.9 0 0 0-.9-.9c-.23 0-.44.09-.6.23A4.42 4.42 0 0 0 7 5.8l.4-1.87 1.27.27a.65.65 0 1 0 .07-.5l-1.43-.3L6.9 5.8a4.43 4.43 0 0 0-2.2.53.88.88 0 0 0-.6-.23.9.9 0 0 0-.35 1.73c0 .1-.01.2-.01.3 0 1.52 1.77 2.75 3.96 2.75s3.96-1.23 3.96-2.76c0-.09 0-.19-.02-.28.27-.15.46-.44.46-.77ZM5.17 7.73a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0Zm2.8 1.33c-.35.35-1.04.37-1.22.37-.18 0-.87-.02-1.22-.37a.13.13 0 0 1 .18-.18c.22.22.7.29 1.04.29s.82-.07 1.04-.29a.13.13 0 0 1 .18.18Zm-.1-1.33a.5.5 0 1 1 1 0 .5.5 0 0 1-1 0Z"/>
              </svg>
            </a>
            <a href={`https://wa.me/?text=${shareTitle}%20${shareUrl}`}
               target="_blank" rel="noopener noreferrer" class="share-btn share-wa" aria-label="Share on WhatsApp">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
                <path d="M7 1C3.69 1 1 3.69 1 7c0 1.07.28 2.07.77 2.93L1 13l3.17-.74A6 6 0 0 0 7 13c3.31 0 6-2.69 6-6s-2.69-6-6-6Zm3.3 8.43c-.14.38-.79.73-1.08.77-.27.04-.6.05-.97-.06-.22-.07-.5-.17-.87-.34-1.52-.66-2.5-2.2-2.58-2.3-.08-.1-.63-.84-.63-1.61s.4-1.14.56-1.3c.14-.16.32-.2.42-.2h.3c.1 0 .23-.03.35.27.13.3.44 1.08.48 1.16.04.08.07.17.01.27-.05.1-.08.16-.16.24-.08.08-.17.18-.24.24-.08.08-.16.17-.07.33.1.17.43.7.92 1.13.63.57 1.16.74 1.33.82.17.08.26.07.36-.04.1-.11.41-.48.52-.64.11-.16.22-.13.37-.08.15.05.96.45 1.12.53.17.08.28.12.32.19.04.06.04.37-.1.75Z"/>
              </svg>
            </a>
            <button id="copy-link-btn" class="share-btn share-copy" aria-label="Copy link">
              <svg id="copy-icon" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4.5" y="4.5" width="7" height="7" rx="1.5"/>
                <path d="M1.5 8.5V2A1.5 1.5 0 0 1 3 .5h6.5"/>
              </svg>
              <svg id="copied-icon" style="display:none" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="#34d399" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 7l3.5 3.5L11 4"/>
              </svg>
            </button>
          </div>

          <!-- AI Summary -->
          {tr?.summary && (
            <div class="ai-summary-box">
              <div class="ai-summary-header">
                <span class="ai-section-label">✦ {t(lang, 'article.ai_summary')}</span>
              </div>
              <p class="ai-summary-text">{tr.summary}</p>
            </div>
          )}

          <!-- Article body -->
          {tr?.body && (
            <div class="article-content">
              {(() => {
                const blocks = tr.body
                  .split(/\n\n+/)
                  .flatMap(para => para.trim().length > 0 ? [para.trim()] : [])
                let inlineInserted = false
                return blocks.map((para, i) => {
                  const isFullStory = para.startsWith('## The Full Story') || para.startsWith('## Tüm Hikaye')
                  const nodes = []
                  if (para.startsWith('## ')) {
                    nodes.push(<h2 class="article-section-heading">{para.slice(3)}</h2>)
                  } else if (para.startsWith('> ')) {
                    nodes.push(<blockquote class="article-pullquote">{para.slice(2)}</blockquote>)
                  } else {
                    nodes.push(<p>{para}</p>)
                  }
                  // Insert inline image after "The Full Story" heading
                  if (isFullStory && !inlineInserted && article.inline_image_url) {
                    inlineInserted = true
                    nodes.push(
                      <figure class="article-inline-figure">
                        <img src={article.inline_image_url} alt={tr?.title} loading="lazy" />
                      </figure>
                    )
                  }
                  return nodes
                })
              })()}
            </div>
          )}

          <!-- Tags -->
          {article.tags.length > 0 && (
            <div class="article-tags">
              <span class="tags-label">Topics</span>
              {article.tags.map(tag => (
                <a href={getLocalizedPath(lang, `/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`)} class="tag-pill">
                  {tag}
                </a>
              ))}
            </div>
          )}

          <!-- AI Analysis -->
          {tr?.ai_analysis && (
            <div class="ai-analysis-box">
              <div class="ai-analysis-header">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M7 4v3.5l2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>{t(lang, 'article.ai_analysis')}</span>
              </div>
              <p class="ai-analysis-text">{tr.ai_analysis}</p>
            </div>
          )}

          <!-- Source bar -->
          <div class="source-bar">
            <div class="source-bar-left">
              <p class="source-bar-label">{t(lang, 'article.source')}</p>
              <p class="source-bar-name">{article.source_name}</p>
            </div>
            <a href={article.source_url} target="_blank" rel="noopener noreferrer" class="source-btn">
              {t(lang, 'article.read_original')}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- WeCult App CTA -->
          <WeCultCTA lang={lang} category={article.category} articleTitle={tr?.title} />

          <!-- Related articles (inline, below CTA) -->
          {related.length > 0 && (
            <div class="related-section">
              <div class="section-header">
                <h3 class="section-title" style={`color:${color}`}>More Like This</h3>
              </div>
              <div class="related-grid">
                {related.map(a => <ArticleCard article={a} lang={lang} size="default" />)}
              </div>
            </div>
          )}

          <a href={getLocalizedPath(lang, '/')} class="back-link">← {t(lang, 'ui.back')}</a>

        </article>

        <!-- Sidebar -->
        <aside class="article-sidebar">
          <div class="sticky-sidebar">
            {related.length > 0 && (
              <div>
                <div class="section-header">
                  <h3 class="section-title" style={`color:${color}`}>Related</h3>
                </div>
                {related.map(a => <ArticleCard article={a} lang={lang} size="compact" />)}
              </div>
            )}
          </div>
        </aside>

      </div>
    </div>

  </div>
</Base>

<!-- ── Read Next sticky bar ─────────────────── -->
<div id="read-next-bar" class="read-next-bar" aria-hidden="true">
  <a href={nextHref} class="read-next-inner">
    {nextArticle.cover_image && (
      <div class="read-next-img">
        <img src={nextArticle.cover_image} alt="" loading="lazy" />
      </div>
    )}
    <div class="read-next-content">
      <span class="read-next-eyebrow">Up next</span>
      <p class="read-next-title">{nextTr?.title}</p>
    </div>
    <div class="read-next-cta">
      <span class="read-next-cat" style={`color:${nextColor}`}>
        {t(lang, `nav.${nextArticle.category}`)}
      </span>
      <span class="read-next-btn">Read →</span>
    </div>
  </a>
  <button id="read-next-close" class="read-next-close" aria-label="Dismiss">✕</button>
</div>

<script>
  // Scroll progress bar
  const bar = document.getElementById('scroll-progress')
  if (bar) {
    const update = () => {
      const scrolled = document.documentElement.scrollTop
      const total = document.documentElement.scrollHeight - document.documentElement.clientHeight
      bar.style.width = total > 0 ? `${(scrolled / total) * 100}%` : '0%'
    }
    window.addEventListener('scroll', update, { passive: true })
    update()
  }

  // Read Next bar
  const readNextBar = document.getElementById('read-next-bar')
  const closeBtn = document.getElementById('read-next-close')
  let barDismissed = false
  if (readNextBar) {
    const showBar = () => {
      const scrolled = document.documentElement.scrollTop
      const total = document.documentElement.scrollHeight - document.documentElement.clientHeight
      if (!barDismissed && total > 0 && scrolled / total > 0.3) {
        readNextBar.classList.add('is-visible')
      }
    }
    window.addEventListener('scroll', showBar, { passive: true })
    closeBtn?.addEventListener('click', () => {
      barDismissed = true
      readNextBar.classList.remove('is-visible')
    })
  }

  // Copy link button
  const copyBtn = document.getElementById('copy-link-btn')
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href)
        const copyIcon = document.getElementById('copy-icon')
        const copiedIcon = document.getElementById('copied-icon')
        if (copyIcon && copiedIcon) {
          copyIcon.style.display = 'none'
          copiedIcon.style.display = 'block'
          setTimeout(() => {
            copyIcon.style.display = 'block'
            copiedIcon.style.display = 'none'
          }, 2000)
        }
      } catch {}
    })
  }
</script>

<style is:global>
  /* Read Next sticky bar */
  .read-next-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 200;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }
  .read-next-bar.is-visible {
    transform: translateY(0);
    pointer-events: auto;
  }
  .read-next-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding: 0.875rem 1.25rem 0.875rem 1rem;
    max-width: 760px;
    margin: 0 auto;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.18);
    text-decoration: none;
    transition: background 0.15s;
  }
  .read-next-inner:hover { background: var(--bg-card-hover); }
  .read-next-img {
    width: 52px; height: 36px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
  }
  .read-next-img img { width: 100%; height: 100%; object-fit: cover; }
  .read-next-content { flex: 1; min-width: 0; }
  .read-next-eyebrow {
    display: block;
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2px;
  }
  .read-next-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }
  .read-next-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }
  .read-next-cat {
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .read-next-btn {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }
  .read-next-close {
    position: absolute;
    top: 50%;
    right: calc((100% - 760px) / 2 + 0.5rem);
    transform: translateY(-50%);
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s;
    z-index: 1;
  }
  .read-next-close:hover { color: var(--text); }
  @media (max-width: 860px) {
    .read-next-close { right: 0.5rem; }
  }

  .scroll-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--progress-color, var(--accent));
    z-index: 9999;
    transition: width 0.1s linear;
    pointer-events: none;
  }

  .article-page { padding-bottom: 5rem; }

  .article-hero {
    position: relative;
    height: 420px;
    overflow: hidden;
  }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; }
  .article-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(12,12,14,0) 0%, rgba(12,12,14,0.7) 100%);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
    padding-top: 2rem;
  }

  .article-body { min-width: 0; }

  /* Meta top */
  .article-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cat-pill-link {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid;
    transition: opacity 0.15s;
  }
  .cat-pill-link:hover { opacity: 0.8; }
  .art-type-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .meta-dot { color: var(--text-muted); font-size: 0.75rem; }
  .meta-text { font-size: 0.8125rem; color: var(--text-muted); }

  /* Title */
  .article-title {
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 1.25rem;
    font-family: var(--font-serif);
  }

  /* Byline */
  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }
  .source-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .source-name { font-size: 0.875rem; font-weight: 600; color: var(--text-secondary); }
  .byline-sep { color: var(--text-muted); font-size: 0.75rem; }
  .clock-icon { color: var(--text-muted); flex-shrink: 0; }
  .read-time { font-size: 0.8125rem; color: var(--text-muted); }

  /* Share bar */
  .share-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .share-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px; height: 30px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--bg-raised);
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    text-decoration: none;
    font-family: inherit;
    font-size: inherit;
  }
  .share-btn:hover { background: var(--bg-card-hover); color: var(--text); border-color: var(--border); }
  .share-x:hover { color: #fff; background: #000; border-color: #000; }
  .share-reddit:hover { color: #fff; background: #ff4500; border-color: #ff4500; }
  .share-wa:hover { color: #fff; background: #25d366; border-color: #25d366; }
  .share-copy:hover { color: var(--accent); border-color: var(--accent); }

  /* AI Summary */
  .ai-summary-box {
    background: var(--bg-card);
    border: 1px solid rgba(201,168,76,0.18);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 1.125rem 1.375rem;
    margin-bottom: 1.75rem;
  }
  .ai-summary-header { margin-bottom: 0.625rem; }
  .ai-section-label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ai-summary-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Body */
  .article-content {
    margin-bottom: 1.75rem;
