---
import Base from '../layouts/Base.astro'
import type { Lang } from '../types'

const lang: Lang = 'en'
---

<Base title="Privacy Policy — WeCult News" lang={lang}>
  <div class="legal-page">
    <div class="container">
      <div class="legal-inner">
        <div class="legal-eyebrow">Privacy Policy</div>
        <h1 class="legal-title">Privacy Policy</h1>
        <p class="legal-meta">Last updated: June 2026</p>

        <div class="legal-body">
          <p>WeCult News is operated by WeCult. This privacy policy explains how we handle information when you visit <strong>wecultdaily.com</strong>.</p>

          <h2>Information We Collect</h2>
          <p>WeCult News is a read-only news and analysis site. We do not require account registration and do not collect personal information directly.</p>
          <p>We may collect anonymous usage analytics (page views, referrer, browser type) through standard web analytics tools. This data is aggregated and not linked to individual users.</p>

          <h2>Cookies</h2>
          <p>We use minimal cookies for site functionality (such as cookie consent preferences). You can manage your cookie preferences using the Cookie Preferences option in our footer.</p>
          <p>We use the following types of cookies:</p>
          <ul>
            <li><strong>Essential cookies:</strong> Required for basic site functionality, including storing your cookie consent preferences.</li>
            <li><strong>Analytics cookies:</strong> Used to understand how visitors interact with our site (e.g., page views, traffic sources). This data is aggregated and anonymous.</li>
            <li><strong>Advertising cookies:</strong> We use Google AdSense to display advertisements. Google AdSense uses cookies, including the DoubleClick cookie, to serve ads based on your prior visits to this site and other sites on the web. You can opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>. Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites.</li>
          </ul>

          <h2>Third-Party Advertising</h2>
          <p>We use Google AdSense, a third-party advertising service provided by Google LLC. Google AdSense uses cookies and web beacons to collect data about your visits to this and other websites in order to provide relevant advertisements. Google's use of advertising cookies enables it and its partners to serve ads based on your visit to our site and/or other sites on the Internet. You can opt out of personalized advertising at <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer">aboutads.info</a>.</p>

          <h2>Third-Party Services</h2>
          <p>WeCult News may display content sourced from or linking to third-party sites. We are not responsible for the privacy practices of those sites.</p>

          <h2>WeCult App</h2>
          <p>For the privacy policy of the WeCult mobile application and main platform, please visit <a href="https://wecult.app" target="_blank" rel="noopener noreferrer">wecult.app</a>.</p>

          <h2>Contact</h2>
          <p>For privacy-related inquiries, please contact us at <a href="mailto:news@wecult.app">news@wecult.app</a> or visit our <a href="/contact">contact page</a>.</p>
        </div>

        <a href="/" class="legal-back">← Back to Home</a>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .legal-page {
    padding: 4rem 0 6rem;
    min-height: 70vh;
  }
  .legal-inner {
    max-width: 680px;
  }
  .legal-eyebrow {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .legal-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }
  .legal-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }
  .legal-body {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 0.9375rem;
  }
  .legal-body h2 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    margin: 2rem 0 0.625rem;
    letter-spacing: -0.01em;
  }
  .legal-body p { margin-bottom: 1rem; }
  .legal-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .legal-body strong { color: var(--text); font-weight: 600; }
  .legal-back {
    display: inline-flex;
    align-items: center;
    margin-top: 3rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .legal-back:hover { color: var(--text-secondary); }
</style>
