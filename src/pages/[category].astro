---
import Base from '../layouts/Base.astro'
import ArticleCard from '../components/article/ArticleCard.astro'
import AdSlot from '../components/ui/AdSlot.astro'
import { t, getLocalizedPath } from '../lib/i18n'
import { articles as mockArticles, getByCategory } from '../lib/articles'
import type { Lang } from '../types'

export function getStaticPaths() {
  return [
    { params: { category: 'games' } },
    { params: { category: 'film'  } },
    { params: { category: 'tv'    } },
    { params: { category: 'books' } },
  ]
}

const { category } = Astro.params
const lang: Lang = 'en'

const catMeta: Record<string, { color: string; label: string; desc: string; icon: string }> = {
  games: { color: 'var(--cat-games)', label: 'Games',  icon: '🎮', desc: 'Latest gaming news, reviews, and releases — curated by AI from top sources.' },
  film:  { color: 'var(--cat-film)',  label: 'Film',   icon: '🎬', desc: 'Film news, box office updates, trailers, and critical analysis from around the web.' },
  tv:    { color: 'var(--cat-tv)',    label: 'TV',     icon: '📺', desc: 'TV show news, casting, renewals, cancellations, and episode recaps.' },
  books: { color: 'var(--cat-books)', label: 'Books',  icon: '📚', desc: 'Book releases, author news, reviews, and literary culture from global sources.' },
}

const typeFilters = ['All', 'News', 'Review', 'Feature', 'Opinion', 'Guide']

const meta = catMeta[category!]
const articles = getByCategory(mockArticles, category! as import('../types').Category)
const [hero, featured, ...rest] = articles
const allOtherArticles = mockArticles.filter(a => a.category !== category).slice(0, 4)

const siteBase = 'https://wecult.app/news'
const catUrl = `${siteBase}/${category}`
const catSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${meta.label} — WeCult News`,
  description: meta.desc,
  url: catUrl,
  publisher: { '@type': 'Organization', name: 'WeCult News', url: siteBase },
}
---

<Base
  title={`${meta.label} News`}
  description={meta.desc}
  lang={lang}
  canonicalUrl={catUrl}
  schema={catSchema}
>
  <div class="cat-page">

    <!-- ── Category hero banner ───────────────────── -->
    <div class="cat-banner" style={`--cat-color:${meta.color}`}>
      <div class="container">
        <div class="cat-banner-inner">
          <div class="cat-breadcrumb">
            <a href={getLocalizedPath(lang, '/')}>WeCult News</a>
            <span>›</span>
            <span style={`color:${meta.color}`}>{meta.label}</span>
          </div>
          <div class="cat-banner-title-row">
            <span class="cat-banner-icon">{meta.icon}</span>
            <h1 class="cat-banner-title" style={`color:${meta.color}`}>{meta.label}</h1>
          </div>
          <p class="cat-banner-desc">{meta.desc}</p>
        </div>
      </div>
      <div class="cat-banner-line" style={`background:${meta.color}`}></div>
    </div>

    <div class="container">

      <!-- ── Hero + sidebar ─────────────────────── -->
      {hero && (
        <div class="cat-hero-section">
          <div class="cat-hero-main">
            <ArticleCard article={hero} lang={lang} size="hero" />
          </div>
          <div class="cat-hero-side">
            {featured && (
              <div class="cat-side-featured">
                <ArticleCard article={featured} lang={lang} size="featured" />
              </div>
            )}
            {rest.slice(0, 2).map(a => (
              <ArticleCard article={a} lang={lang} size="compact" />
            ))}
          </div>
        </div>
      )}

      <!-- ── Filter bar ──────────────────────────── -->
      <div class="cat-filter-bar" id="filter-bar">
        <div class="cat-filter-tabs">
          {typeFilters.map((f, i) => (
            <button
              class={`filter-tab${i === 0 ? ' is-active' : ''}`}
              data-filter={f.toLowerCase()}
            >
              {f}
            </button>
          ))}
        </div>
        <span class="cat-count">{articles.length} articles</span>
      </div>

      <AdSlot class="cat-filter-ad" />

      <!-- ── Article grid ────────────────────────── -->
      {articles.length === 0 ? (
        <div class="cat-empty">
          <p>No articles found in this category yet.</p>
        </div>
      ) : (
        <div class="cat-grid cards-grid" id="cat-grid">
          {articles.map(a => (
            <div class="cat-grid-item" data-type={a.article_type}>
              <ArticleCard article={a} lang={lang} size="default" />
            </div>
          ))}
        </div>
      )}

      <!-- ── More from WeCult News ───────────────── -->
      {allOtherArticles.length > 0 && (
        <section class="cat-more">
          <div class="section-header">
            <h2 class="section-title" style="color:var(--text-muted)">More from WeCult News</h2>
            <a href={getLocalizedPath(lang, '/')} class="section-link">All categories →</a>
          </div>
          <div class="cat-more-grid">
            {allOtherArticles.map(a => <ArticleCard article={a} lang={lang} size="default" />)}
          </div>
        </section>
      )}

    </div>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab')
  const items = document.querySelectorAll<HTMLElement>('.cat-grid-item')

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('is-active'))
      tab.classList.add('is-active')
      const filter = tab.dataset.filter
      items.forEach(item => {
        item.style.display = (filter === 'all' || item.dataset.type === filter) ? '' : 'none'
      })
    })
  })
</script>

<style is:global>
  .cat-page { padding-bottom: 5rem; }

  /* ── Banner ────────────────────────────────────── */
  .cat-banner {
    padding: 2.25rem 0 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
    position: relative;
    background: radial-gradient(ellipse at 0% 0%, color-mix(in srgb, var(--cat-color) 6%, transparent) 0%, transparent 60%);
  }
  .cat-banner-inner { max-width: 640px; }
  .cat-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .cat-breadcrumb a:hover { color: var(--text-secondary); }
  .cat-banner-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.625rem;
  }
  .cat-banner-icon { font-size: 2rem; line-height: 1; }
  .cat-banner-title {
    font-size: 2.25rem;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .cat-banner-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .cat-banner-line {
    position: absolute;
    bottom: 0; left: 0;
    width: 56px; height: 2px;
    border-radius: 2px;
    opacity: 0.7;
    margin-left: 1.5rem;
  }

  /* ── Hero section ──────────────────────────────── */
  .cat-hero-section {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.25rem;
    margin-bottom: 2rem;
    align-items: start;
  }
  .cat-hero-main { min-width: 0; }
  .cat-hero-side {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
  }
  .cat-side-featured { margin-bottom: 0.125rem; }

  /* ── Filter bar ────────────────────────────────── */
  .cat-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
    gap: 1rem;
  }
  .cat-filter-tabs {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .filter-tab {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    padding: 0.3125rem 0.75rem;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .filter-tab:hover { color: var(--text-secondary); background: var(--bg-card); }
  .filter-tab.is-active {
    color: var(--text);
    background: var(--bg-card);
    border-color: var(--border);
  }
  .cat-count { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; flex-shrink: 0; }

  /* ── Grid ──────────────────────────────────────── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .cat-empty {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  /* ── More ──────────────────────────────────────── */
  .cat-more { margin-top: 1rem; }
  .cat-more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  /* ── Mobile ────────────────────────────────────── */
  @media (max-width: 768px) {
    .cat-hero-section { grid-template-columns: 1fr !important; }
    .cat-hero-side { display: none !important; }
    .cat-grid, .cat-more-grid { grid-template-columns: 1fr !important; }
  }
  @media (min-width: 480px) and (max-width: 768px) {
    .cat-grid, .cat-more-grid { grid-template-columns: 1fr 1fr !important; }
  }
</style>
