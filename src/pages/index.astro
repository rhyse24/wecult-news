---
import Base from '../layouts/Base.astro'
import HomeStyles from '../components/layout/HomeStyles.astro'
import ArticleCard from '../components/article/ArticleCard.astro'
import AdSlot from '../components/ui/AdSlot.astro'
import { t, getLangFromUrl, getLocalizedPath } from '../lib/i18n'
import { articles as mockArticles, getByLang } from '../lib/articles'
import type { Lang } from '../types'

const lang: Lang = getLangFromUrl(Astro.url)
const langArticles = getByLang(mockArticles, lang)
const articles = langArticles.length >= 3 ? langArticles : mockArticles

const sorted = [...articles].sort(
  (a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime()
)

const heroArticles     = sorted.slice(0, 4)   // 1 büyük hero + 3 side kart
const gridArticles     = sorted.slice(4)       // hero'dakiler tekrar gösterilmesin
const tickerTags       = [...new Set(mockArticles.flatMap(a => a.tags))].slice(0, 14)

const catColors: Record<string, string> = {
  games: 'var(--cat-games)', film: 'var(--cat-film)',
  tv: 'var(--cat-tv)', books: 'var(--cat-books)',
}

function buildHeroSrcSet(url: string | undefined): string | undefined {
  if (!url) return undefined
  if (url.includes('wsrv.nl')) {
    const s400 = url.replace(/([?&]w=)\d+/, '$1400')
    const s700 = url.replace(/([?&]w=)\d+/, '$1700')
    return `${s400} 400w, ${s700} 700w, ${url} 900w`
  }
  if (url.includes('image.tmdb.org')) {
    const w342 = url.replace(/\/t\/p\/[a-z0-9]+\//, '/t/p/w342/')
    const w500 = url.replace(/\/t\/p\/[a-z0-9]+\//, '/t/p/w500/')
    const w780 = url.replace(/\/t\/p\/[a-z0-9]+\//, '/t/p/w780/')
    return `${w342} 342w, ${w500} 500w, ${w780} 780w`
  }
  return undefined
}
const heroImage = heroArticles[0]?.cover_image
---

<Base
  title="Home"
  lang={lang}
  canonicalUrl="https://news.wecult.app/"
  hreflang={{ en: 'https://news.wecult.app/', tr: 'https://news.wecult.app/tr/', es: 'https://news.wecult.app/es/' }}
  description={t(lang, 'tagline')}
  preloadImage={heroImage}
  preloadImageSrcset={buildHeroSrcSet(heroImage)}
>
<div class="hp-page">

  <!-- ── Hero: static grid (1 büyük + 3 side) ─── -->
  <div class="container">
    <div class="hp-hero-grid">

      <div class="hp-hero-main">
        {heroArticles[0] && <ArticleCard article={heroArticles[0]} lang={lang} size="hero" />}
      </div>

      <aside class="hp-hero-side">
        <div class="hs-label">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 3.5v2.7l1.8 1.1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Latest
        </div>
        {heroArticles.slice(1).map(a => (
          <ArticleCard article={a} lang={lang} size="compact" />
        ))}
      </aside>

    </div>
  </div>

  <!-- ── Ticker strip ──────────────────────── -->
  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-inner">
      {tickerTags.map(tag => (
        <a href={getLocalizedPath(lang, `/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`)} class="ticker-tag">
          <span class="ticker-sep">✦</span>{tag}
        </a>
      ))}
      {tickerTags.map(tag => (
        <a href={getLocalizedPath(lang, `/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`)} class="ticker-tag" tabindex="-1">
          <span class="ticker-sep">✦</span>{tag}
        </a>
      ))}
    </div>
  </div>


  <!-- ── Main grid ────────────────────────── -->
  <div class="hp-body-section">
  <div class="hp-body-fade"></div>
  <div class="container">

    <div class="section-header">
      <div class="section-header-left">
        <h2 class="section-title">All Stories</h2>
        <p class="section-subtitle">Entertainment intelligence, curated daily</p>
      </div>
      <span class="story-count">{gridArticles.length} articles</span>
    </div>

    <div class="story-grid">
      {gridArticles.map((a, i) => {
        if (i === 0) return (
          <div class="story-lead" style={`--card-accent:${catColors[a.category]}`}>
            <ArticleCard article={a} lang={lang} size="featured" />
          </div>
        )
        if (i === 5) return (
          <Fragment>
            <AdSlot type="rectangle" class="story-grid-ad" />
            <ArticleCard article={a} lang={lang} size="default" />
          </Fragment>
        )
        return <ArticleCard article={a} lang={lang} size="default" />
      })}
    </div>

    <AdSlot type="horizontal" class="story-bottom-ad" />

  </div>
  </div>

</div>
</Base>

<HomeStyles />
