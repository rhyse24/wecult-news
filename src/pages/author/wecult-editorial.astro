---
import Base from '../../layouts/Base.astro'
import ArticleCard from '../../components/article/ArticleCard.astro'
import { articles as allArticles } from '../../lib/articles'
import type { Lang } from '../../types'

const lang: Lang = 'en'
const siteBase = 'https://wecultdaily.com'
const pageUrl = `${siteBase}/author/wecult-editorial`

const authorArticles = allArticles
  .filter(a => a.author === 'WeCult Editorial')
  .slice(0, 24)

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'WeCult Editorial',
  url: pageUrl,
  worksFor: {
    '@type': 'Organization',
    name: 'WeCult News',
    url: siteBase,
  },
  description: 'WeCult Editorial is the AI-assisted editorial team behind WeCult News — covering film, TV, games, and books for passionate fans worldwide.',
  knowsAbout: ['Film', 'Television', 'Video Games', 'Books', 'Entertainment News'],
  sameAs: ['https://wecult.app'],
}
---

<Base
  title="WeCult Editorial — Author"
  description="WeCult Editorial is the AI-assisted editorial team behind WeCult News, covering film, TV, games, and books for passionate fans worldwide."
  lang={lang}
  canonicalUrl={pageUrl}
  schema={schema}
>
  <div class="author-page container">

    <div class="author-header">
      <div class="author-avatar">
        <svg width="40" height="40" viewBox="0 0 18 18" fill="none">
          <rect x="0" y="0" width="3" height="18" rx="1.5" fill="var(--accent)"/>
          <rect x="6" y="4" width="3" height="14" rx="1.5" fill="var(--accent)" opacity="0.6"/>
          <rect x="12" y="8" width="3" height="10" rx="1.5" fill="var(--accent)" opacity="0.25"/>
        </svg>
      </div>
      <div class="author-info">
        <h1 class="author-name">WeCult Editorial</h1>
        <p class="author-role">Editorial Team · WeCult News</p>
        <p class="author-bio">
          WeCult Editorial is the AI-assisted editorial team behind WeCult News. We cover the stories that matter to passionate fans of film, TV, games, and books — sourcing from the world's top entertainment outlets and expanding each story with context, analysis, and the fan angle. Our mission: smart entertainment journalism for the WeCult community.
        </p>
        <div class="author-links">
          <a href={`${siteBase}/feed.xml`} class="author-link" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
              <path d="M2 2a1 1 0 0 0-1 1v1a9 9 0 0 1 9 9h1a1 1 0 0 0 1-1A10 10 0 0 0 2 2zm0 4a1 1 0 0 0-1 1v1a5 5 0 0 1 5 5h1a1 1 0 0 0 1-1A6 6 0 0 0 2 6zm0 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
            </svg>
            RSS Feed
          </a>
          <a href="https://wecult.app" class="author-link" target="_blank" rel="noopener noreferrer">
            WeCult App
          </a>
        </div>
      </div>
    </div>

    <div class="author-stats">
      <div class="author-stat">
        <span class="stat-number">{authorArticles.length}+</span>
        <span class="stat-label">Articles</span>
      </div>
      <div class="author-stat">
        <span class="stat-number">4</span>
        <span class="stat-label">Categories</span>
      </div>
      <div class="author-stat">
        <span class="stat-number">2</span>
        <span class="stat-label">Languages</span>
      </div>
    </div>

    <div class="author-section-title">
      <h2>Latest Articles</h2>
    </div>

    <div class="author-grid">
      {authorArticles.map(a => <ArticleCard article={a} lang={lang} size="default" />)}
    </div>

  </div>
</Base>

<style>
  .author-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .author-header {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    margin-bottom: 1.5rem;
  }

  .author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 2px solid color-mix(in srgb, var(--accent) 30%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-info { flex: 1; min-width: 0; }

  .author-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
    font-family: var(--font-serif);
    margin-bottom: 0.25rem;
  }

  .author-role {
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.875rem;
  }

  .author-bio {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .author-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    padding: 0.4rem 0.875rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s, border-color 0.15s;
  }
  .author-link:hover { color: var(--text); border-color: var(--border); }

  .author-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .author-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-serif);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .author-section-title {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .author-section-title h2 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
  }

  .author-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .author-header { flex-direction: column; }
    .author-grid { grid-template-columns: repeat(2, 1fr); }
    .author-stats { flex-wrap: wrap; }
  }

  @media (max-width: 600px) {
    .author-grid { grid-template-columns: 1fr; }
  }
</style>
