---
import Base from '../layouts/Base.astro'
import type { Lang } from '../types'

const lang: Lang = 'en'
---

<Base title="Cookie Policy — WeCult News" lang={lang}>
  <div class="legal-page">
    <div class="container">
      <div class="legal-inner">
        <div class="legal-eyebrow">Cookie Policy</div>
        <h1 class="legal-title">Cookie Policy</h1>
        <p class="legal-meta">Last updated: June 2026</p>

        <div class="legal-body">
          <p>This Cookie Policy explains how WeCult News (<strong>wecultdaily.com</strong>) uses cookies and similar tracking technologies when you visit our site.</p>

          <h2>What Are Cookies?</h2>
          <p>Cookies are small text files stored on your device when you visit a website. They help the site remember your preferences and understand how you use it.</p>

          <h2>Types of Cookies We Use</h2>

          <h3>Essential Cookies</h3>
          <p>These cookies are required for the site to function properly. They include cookies that store your cookie consent preferences. These cannot be disabled.</p>

          <h3>Analytics Cookies</h3>
          <p>We use analytics tools to understand how visitors interact with our site — such as which pages are most visited, where traffic comes from, and how long visitors stay. This data is aggregated and anonymous. You can opt out of analytics cookies via the Cookie Preferences panel.</p>

          <h3>Advertising Cookies</h3>
          <p>We display advertisements through Google AdSense. Google uses cookies, including the DoubleClick cookie, to serve ads based on your browsing history on this and other websites. These cookies allow Google and its partners to:</p>
          <ul>
            <li>Show you personalized ads based on your interests</li>
            <li>Limit how many times you see the same ad</li>
            <li>Measure the effectiveness of ad campaigns</li>
          </ul>
          <p>You can opt out of personalized advertising at any time:</p>
          <ul>
            <li><a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ads Settings</a></li>
            <li><a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">Digital Advertising Alliance (aboutads.info)</a></li>
            <li><a href="https://www.youronlinechoices.eu/" target="_blank" rel="noopener noreferrer">Your Online Choices (EU)</a></li>
          </ul>

          <h2>Managing Your Cookie Preferences</h2>
          <p>You can manage or withdraw your consent at any time using the <button onclick="window.dispatchEvent(new Event('wecult:consent-open'))" style="background:none;border:none;cursor:pointer;color:var(--accent);font-size:inherit;padding:0;text-decoration:underline;text-underline-offset:3px;">Cookie Preferences</button> panel in our footer.</p>
          <p>You can also control cookies through your browser settings. Note that disabling certain cookies may affect site functionality.</p>

          <h2>Third-Party Cookies</h2>
          <p>Third-party services such as Google AdSense may set their own cookies. These are governed by the respective third-party privacy policies. We do not have control over these cookies.</p>

          <h2>Contact</h2>
          <p>For questions about our cookie practices, contact us at <a href="mailto:news@wecult.app">news@wecult.app</a>.</p>
        </div>

        <a href="/" class="legal-back">← Back to Home</a>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .legal-page {
    padding: 4rem 0 6rem;
    min-height: 70vh;
  }
  .legal-inner { max-width: 680px; }
  .legal-eyebrow {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .legal-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }
  .legal-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }
  .legal-body {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 0.9375rem;
  }
  .legal-body h2 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    margin: 2rem 0 0.625rem;
    letter-spacing: -0.01em;
  }
  .legal-body h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    margin: 1.5rem 0 0.5rem;
  }
  .legal-body p { margin-bottom: 1rem; }
  .legal-body ul { margin: 0.5rem 0 1rem 1.5rem; }
  .legal-body li { margin-bottom: 0.375rem; }
  .legal-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .legal-body strong { color: var(--text); font-weight: 600; }
  .legal-back {
    display: inline-flex;
    align-items: center;
    margin-top: 3rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .legal-back:hover { color: var(--text-secondary); }
</style>
