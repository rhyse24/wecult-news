---
import type { Lang } from '../../types'

interface Props {
  category?: string
  color?: string
  lang: Lang
  variant?: 'default' | 'minimal'
}

const { category, color = 'var(--accent)', lang, variant = 'default' } = Astro.props

const catLabel: Record<string, string> = {
  games: 'gaming',
  film: 'film',
  tv: 'TV',
  books: 'books',
  default: 'entertainment',
}
const label = catLabel[category ?? 'default'] ?? 'entertainment'

const copy = {
  headline: variant === 'minimal'
    ? 'Stay in the loop'
    : `Get the best ${label} news, before everyone else`,
  sub: variant === 'minimal'
    ? 'AI-curated entertainment news, delivered daily.'
    : `AI-curated highlights from the top ${label} sources — delivered to your inbox every morning. No spam, unsubscribe any time.`,
  cta: 'Notify me',
  placeholder: 'your@email.com',
  note: 'Free · No spam · Unsubscribe any time',
}
---

<div class={`nl-hook nl-hook--${variant}`} style={`--nl-color:${color}`} id="newsletter-hook">
  {variant === 'default' && (
    <div class="nl-icon-row">
      <div class="nl-icon-wrap">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M3 5h14a1 1 0 011 1v8a1 1 0 01-1 1H3a1 1 0 01-1-1V6a1 1 0 011-1z" stroke="var(--nl-color)" stroke-width="1.5"/>
          <path d="M2 6l8 5.5L18 6" stroke="var(--nl-color)" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="nl-tag">Newsletter</span>
    </div>
  )}

  <h3 class="nl-headline">{copy.headline}</h3>
  <p class="nl-sub">{copy.sub}</p>

  <form class="nl-form" id="nl-form" novalidate>
    <div class="nl-input-row">
      <input
        type="email"
        name="email"
        placeholder={copy.placeholder}
        class="nl-input"
        id="nl-input"
        autocomplete="email"
        required
      />
      <button type="submit" class="nl-btn">
        <span class="nl-btn-text">{copy.cta}</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <p class="nl-note" id="nl-note">{copy.note}</p>
    <p class="nl-success" id="nl-success" aria-live="polite">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <circle cx="7" cy="7" r="6" fill="var(--nl-color)" opacity="0.15"/>
        <path d="M4 7l2.5 2.5L10 4.5" stroke="var(--nl-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      You're in! First issue lands tomorrow morning.
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('nl-form') as HTMLFormElement
  const input = document.getElementById('nl-input') as HTMLInputElement
  const note = document.getElementById('nl-note')!
  const success = document.getElementById('nl-success')!

  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    const email = input?.value.trim()
    if (!email || !email.includes('@')) {
      input?.classList.add('is-error')
      input?.focus()
      return
    }
    input?.classList.remove('is-error')
    // TODO: wire to actual email service (Resend / ConvertKit)
    form.style.display = 'none'
    success.style.display = 'flex'
  })

  input?.addEventListener('input', () => input.classList.remove('is-error'))
</script>

<style is:global>
  .nl-hook {
    background: var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--nl-color) 20%, var(--border-subtle));
    border-radius: var(--radius-xl);
    padding: 2rem;
    margin: 3rem 0;
    position: relative;
    overflow: hidden;
  }
  .nl-hook::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 0% 0%, color-mix(in srgb, var(--nl-color) 6%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }
  .nl-hook--minimal {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
  }

  .nl-icon-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }
  .nl-icon-wrap {
    width: 36px; height: 36px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--nl-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--nl-color) 20%, transparent);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .nl-tag {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--nl-color);
  }

  .nl-headline {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .nl-hook--minimal .nl-headline { font-size: 0.9375rem; }

  .nl-sub {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 480px;
  }
  .nl-hook--minimal .nl-sub { font-size: 0.8125rem; margin-bottom: 1rem; }

  .nl-form { position: relative; }

  .nl-input-row {
    display: flex;
    gap: 0.5rem;
    max-width: 440px;
  }
  .nl-input {
    flex: 1;
    height: 42px;
    padding: 0 1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    color: var(--text);
    outline: none;
    transition: border-color 0.15s;
    min-width: 0;
  }
  .nl-input::placeholder { color: var(--text-muted); }
  .nl-input:focus { border-color: var(--nl-color); }
  .nl-input.is-error { border-color: #f87171; }

  .nl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 42px;
    padding: 0 1.125rem;
    background: var(--nl-color);
    color: #0c0c0e;
    font-size: 0.8125rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition: opacity 0.15s, transform 0.15s;
    letter-spacing: 0.01em;
    flex-shrink: 0;
  }
  .nl-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  .nl-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.625rem;
  }

  .nl-success {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--nl-color);
    padding: 0.75rem 0;
  }
</style>
