---
import type { Lang } from '../../types'

interface Props {
  lang: Lang
  category?: string
  articleTitle?: string
}

const { lang, category, articleTitle } = Astro.props

const catMeta: Record<string, { icon: string; verb: string; color: string }> = {
  games: { icon: '🎮', verb: 'Track your games',  color: 'var(--cat-games)' },
  film:  { icon: '🎬', verb: 'Track your films',  color: 'var(--cat-film)'  },
  tv:    { icon: '📺', verb: 'Track your series', color: 'var(--cat-tv)'    },
  books: { icon: '📚', verb: 'Track your books',  color: 'var(--cat-books)' },
}
const meta = catMeta[category ?? ''] ?? { icon: '✦', verb: 'Track everything', color: 'var(--accent)' }
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<div class="wc-cta" style={`--cta-color:${meta.color}`}>

  <!-- Phone mockup -->
  <div class="cta-phone-wrap">
    <div class="cta-phone">
      <div class="cta-phone-notch"></div>
      <div class="cta-phone-screen">
        <img class="cta-slide is-active" src={`${base}/screenshots/home.jpg`}            alt="Ana Sayfa"  loading="lazy" />
        <img class="cta-slide"           src={`${base}/screenshots/social-kesfet.jpg`}   alt="Sosyal"     loading="lazy" />
        <img class="cta-slide"           src={`${base}/screenshots/tracking-active.jpg`} alt="Takip"      loading="lazy" />
        <img class="cta-slide"           src={`${base}/screenshots/profile.jpg`}         alt="Profil"     loading="lazy" />
      </div>
    </div>
    <div class="cta-phone-tabs">
      <button class="cta-ptab is-active" data-idx="0" aria-label="Ana Sayfa">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 6.5L8 2l6 4.5V14H10v-3.5H6V14H2V6.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span>Ana Sayfa</span>
      </button>
      <button class="cta-ptab" data-idx="1" aria-label="Sosyal">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="6" cy="5" r="2.5" stroke="currentColor" stroke-width="1.4"/><path d="M1 13c0-2.76 2.24-5 5-5s5 2.24 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="12.5" cy="5" r="2" stroke="currentColor" stroke-width="1.2"/><path d="M15 13c0-2.21-1.34-3.97-3-4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        <span>Sosyal</span>
      </button>
      <button class="cta-ptab" data-idx="2" aria-label="Takip">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 2h8a1 1 0 011 1v10l-5-3-5 3V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <span>Takip</span>
      </button>
      <button class="cta-ptab" data-idx="3" aria-label="Profil">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5.5" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M2 14c0-3.31 2.69-6 6-6s6 2.69 6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <span>Profil</span>
      </button>
    </div>
  </div>

  <!-- Copy + actions -->
  <div class="wc-cta-body">
    <div class="wc-cta-copy">
      <p class="wc-cta-label">WeCult App</p>
      <p class="wc-cta-headline">{meta.verb} — all in one place</p>
      <p class="wc-cta-sub">
        Follow releases, track progress, discover what matches your taste.
        {articleTitle && <span> Rate "{articleTitle.substring(0, 40)}{articleTitle.length > 40 ? '…' : ''}" on the app.</span>}
      </p>
    </div>
    <div class="wc-cta-actions">
      <a href="https://wecult.app" target="_blank" rel="noopener noreferrer" class="wc-cta-btn wc-cta-btn--primary">
        {meta.icon} Open in WeCult
      </a>
      <a href="https://wecult.app" target="_blank" rel="noopener noreferrer" class="wc-cta-btn wc-cta-btn--ghost">
        Download free
      </a>
    </div>
  </div>

</div>

<script>
  document.querySelectorAll<HTMLElement>('.cta-phone-wrap').forEach(wrap => {
    const slides = wrap.querySelectorAll<HTMLElement>('.cta-slide')
    const tabs   = wrap.querySelectorAll<HTMLButtonElement>('.cta-ptab')
    let current  = 0

    function goTo(n: number) {
      slides[current].classList.remove('is-active')
      tabs[current].classList.remove('is-active')
      current = n
      slides[current].classList.add('is-active')
      tabs[current].classList.add('is-active')
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => goTo(i)))
  })
</script>

<style is:global>
  .wc-cta {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--cta-color) 18%, var(--border-subtle));
    border-radius: var(--radius-xl);
    margin: 2rem 0;
    position: relative;
    overflow: hidden;
  }
  .wc-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 100% 50%, color-mix(in srgb, var(--cta-color) 6%, transparent) 0%, transparent 55%);
    pointer-events: none;
  }

  /* ── Phone mockup ── */
  .cta-phone-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cta-phone {
    width: 120px;
    aspect-ratio: 9 / 19;
    border-radius: 18px;
    border: 2px solid rgba(255,255,255,0.13);
    background: #0a0a0c;
    overflow: hidden;
    position: relative;
    box-shadow:
      0 0 0 1px rgba(0,0,0,0.6),
      0 12px 32px rgba(0,0,0,0.55),
      inset 0 0 0 1px rgba(255,255,255,0.04);
  }

  .cta-phone-notch {
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    width: 36px;
    height: 7px;
    border-radius: 4px;
    background: #0a0a0c;
    border: 1px solid rgba(255,255,255,0.08);
    z-index: 2;
  }

  .cta-phone-screen {
    position: absolute;
    inset: 0;
  }
  .cta-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .cta-slide.is-active { opacity: 1; }

  /* ── Tab nav ── */
  .cta-phone-tabs {
    display: flex;
    gap: 0.25rem;
  }
  .cta-ptab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 5px 6px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
    font-size: 0;
  }
  .cta-ptab span {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .cta-ptab:hover {
    color: var(--text-secondary);
    background: var(--bg-raised);
  }
  .cta-ptab.is-active {
    color: var(--cta-color);
    background: color-mix(in srgb, var(--cta-color) 10%, transparent);
    border-color: color-mix(in srgb, var(--cta-color) 20%, transparent);
  }

  /* ── Body ── */
  .wc-cta-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .wc-cta-copy { display: flex; flex-direction: column; gap: 0.375rem; }

  .wc-cta-label {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--cta-color);
  }
  .wc-cta-headline {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .wc-cta-sub {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .wc-cta-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .wc-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 38px;
    padding: 0 1.125rem;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    transition: opacity 0.15s, transform 0.15s;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .wc-cta-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  .wc-cta-btn--primary {
    background: var(--cta-color);
    color: #0c0c0e;
  }
  .wc-cta-btn--ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .wc-cta-btn--ghost:hover { color: var(--text); border-color: var(--text-muted); }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .wc-cta { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    .cta-phone-wrap { flex-direction: row; align-items: flex-end; gap: 1rem; }
    .cta-phone { width: 90px; }
    .cta-phone-tabs { flex-direction: column; gap: 0.2rem; }
  }
</style>
