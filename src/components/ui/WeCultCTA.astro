---
import type { Lang } from '../../types'

interface Props {
  lang: Lang
  category?: string
  articleTitle?: string
}

const { category, articleTitle } = Astro.props

const catMeta: Record<string, { icon: string; verb: string; color: string }> = {
  games: { icon: '🎮', verb: 'Track your games',    color: 'var(--cat-games)' },
  film:  { icon: '🎬', verb: 'Track your films',    color: 'var(--cat-film)'  },
  tv:    { icon: '📺', verb: 'Track your series',   color: 'var(--cat-tv)'    },
  books: { icon: '📚', verb: 'Track your books',    color: 'var(--cat-books)' },
}
const meta = catMeta[category ?? ''] ?? { icon: '✦', verb: 'Track everything', color: 'var(--accent)' }
---

<div class="wc-cta" style={`--cta-color:${meta.color}`}>
  <div class="wc-cta-left">
    <div class="wc-cta-icon-wrap">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <rect x="0" y="2" width="4" height="18" rx="2" fill="var(--cta-color)"/>
        <rect x="7" y="6" width="4" height="14" rx="2" fill="var(--cta-color)" opacity="0.55"/>
        <rect x="14" y="10" width="4" height="10" rx="2" fill="var(--cta-color)" opacity="0.25"/>
      </svg>
    </div>
    <div class="wc-cta-copy">
      <p class="wc-cta-label">WeCult App</p>
      <p class="wc-cta-headline">{meta.verb} — all in one place</p>
      <p class="wc-cta-sub">
        Follow releases, track progress, discover what matches your taste.
        {articleTitle && <span> Rate "{articleTitle.substring(0, 40)}{articleTitle.length > 40 ? '…' : ''}" on the app.</span>}
      </p>
    </div>
  </div>
  <div class="wc-cta-actions">
    <a href="#" class="wc-cta-btn wc-cta-btn--primary">
      {meta.icon} Open in WeCult
    </a>
    <a href="#" class="wc-cta-btn wc-cta-btn--ghost">
      Download free
    </a>
  </div>
</div>

<style is:global>
  .wc-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.375rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--cta-color) 18%, var(--border-subtle));
    border-radius: var(--radius-xl);
    margin: 2rem 0;
    position: relative;
    overflow: hidden;
    flex-wrap: wrap;
  }
  .wc-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 100% 50%, color-mix(in srgb, var(--cta-color) 5%, transparent) 0%, transparent 55%);
    pointer-events: none;
  }

  .wc-cta-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    min-width: 0;
  }

  .wc-cta-icon-wrap {
    width: 44px; height: 44px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--cta-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--cta-color) 20%, transparent);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .wc-cta-copy { min-width: 0; }
  .wc-cta-label {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--cta-color);
    margin-bottom: 0.2rem;
  }
  .wc-cta-headline {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }
  .wc-cta-sub {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .wc-cta-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .wc-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 38px;
    padding: 0 1rem;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    transition: opacity 0.15s, transform 0.15s;
    letter-spacing: 0.01em;
  }
  .wc-cta-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  .wc-cta-btn--primary {
    background: var(--cta-color);
    color: #0c0c0e;
  }
  .wc-cta-btn--ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .wc-cta-btn--ghost:hover { color: var(--text); border-color: var(--text-muted); }
</style>
