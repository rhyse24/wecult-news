<style is:global>

  .scroll-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--progress-color, var(--accent));
    z-index: 9999;
    transition: width 0.1s linear;
    pointer-events: none;
  }

  .article-page { padding-bottom: 5rem; }

  .article-hero {
    position: relative;
    height: 420px;
    overflow: hidden;
  }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; }
  .article-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(12,12,14,0) 0%, rgba(12,12,14,0.7) 100%);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
    padding-top: 2rem;
  }

  .article-body { min-width: 0; }

  /* Meta top */
  .article-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cat-pill-link {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid;
    transition: opacity 0.15s;
  }
  .cat-pill-link:hover { opacity: 0.8; }
  .art-type-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .breaking-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: #ef4444;
    padding: 0.2em 0.55em;
    border-radius: 4px;
    animation: breaking-pulse 1.8s ease-in-out infinite;
  }
  @keyframes breaking-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  .meta-dot { color: var(--text-muted); font-size: 0.75rem; }
  .meta-text { font-size: 0.8125rem; color: var(--text-muted); }

  /* Title */
  .article-title {
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 1.25rem;
    font-family: var(--font-serif);
  }

  /* Byline */
  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }
  .source-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .byline-authorship { display: flex; flex-direction: column; gap: 0.1rem; }
  .author-name { font-size: 0.875rem; font-weight: 600; color: var(--text-secondary); }
  .author-name--link { transition: color 0.15s; }
  .author-name--link:hover { color: var(--accent); }
  .source-via { font-size: 0.75rem; color: var(--text-muted); }
  .byline-sep { color: var(--text-muted); font-size: 0.75rem; }
  .clock-icon { color: var(--text-muted); flex-shrink: 0; }
  .read-time { font-size: 0.8125rem; color: var(--text-muted); }

  /* Share bar */
  .share-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .share-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px; height: 30px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--bg-raised);
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    text-decoration: none;
    font-family: inherit;
    font-size: inherit;
  }
  .share-btn:hover { background: var(--bg-card-hover); color: var(--text); border-color: var(--border); }
  .share-x:hover { color: #fff; background: #000; border-color: #000; }
  .share-reddit:hover { color: #fff; background: #ff4500; border-color: #ff4500; }
  .share-wa:hover { color: #fff; background: #25d366; border-color: #25d366; }
  .share-copy:hover { color: var(--accent); border-color: var(--accent); }

  /* AI Summary */
  .ai-summary-box {
    background: var(--bg-card);
    border: 1px solid rgba(201,168,76,0.18);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 1.125rem 1.375rem;
    margin-bottom: 1.75rem;
  }
  .ai-summary-header { margin-bottom: 0.625rem; }
  .ai-section-label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ai-summary-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Article body */
  .article-content {
    margin-bottom: 2rem;
  }

  /* Lead paragraph */
  .article-content p:first-of-type {
    font-size: 1.25rem;
    line-height: 1.75;
    color: #edeae0;
    font-weight: 400;
    margin-bottom: 2em;
    letter-spacing: -0.005em;
    padding-bottom: 1.5em;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Drop cap */
  .article-content p:first-of-type::first-letter {
    float: left;
    font-size: 4rem;
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--accent);
    line-height: 0.8;
    margin-right: 0.1em;
    margin-top: 0.05em;
  }

  /* Body paragraphs */
  .article-content p {
    font-size: 1.1rem;
    color: #d4d0c6;
    line-height: 1.9;
    margin-bottom: 1.625em;
    letter-spacing: 0.003em;
  }
  .article-content p:last-of-type { margin-bottom: 0; }

  /* Auto visual break every 4 paragraphs */
  .article-content p:nth-of-type(4n+1):not(:first-of-type) {
    margin-top: 0.5em;
    padding-top: 1.5em;
    border-top: 1px solid var(--border-subtle);
  }

  /* Bold & italic inside body */
  .article-content strong {
    color: #f0ece4;
    font-weight: 700;
  }
  .article-content em {
    font-style: italic;
    color: #c0bcb0;
  }

  /* Bullet lists */
  .article-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75em 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 30%, var(--border-subtle));
    padding-left: 1.25rem;
  }
  .article-list li {
    font-size: 1.075rem;
    color: #d8d4ca;
    line-height: 1.75;
    padding-left: 0.125rem;
    position: relative;
  }
  .article-list li::before {
    content: '✦';
    position: absolute;
    left: -1.375rem;
    font-size: 0.4rem;
    color: var(--accent);
    top: 0.55em;
    opacity: 0.7;
  }

  /* List article — numbered item cards */
  .article-content--list p:first-of-type {
    font-size: 1.075rem;
    font-weight: 400;
    color: #d4d0c6;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }
  .article-content--list p:first-of-type::first-letter { all: unset; }

  .list-item-card {
    display: flex;
    gap: 1.125rem;
    padding: 1.125rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 0.75rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .list-item-card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border-subtle));
    background: var(--bg-card-hover);
  }

  .list-item-num {
    font-size: 2rem;
    font-weight: 900;
    color: var(--accent);
    opacity: 0.55;
    line-height: 1;
    min-width: 2rem;
    font-family: var(--font-serif);
    padding-top: 0.1em;
    flex-shrink: 0;
  }

  .list-item-body { flex: 1; min-width: 0; }

  .list-item-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #edeae0;
    margin: 0 0 0.375rem 0;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .list-item-desc {
    font-size: 0.9375rem;
    color: #a8a49a;
    line-height: 1.7;
    margin: 0;
  }

  /* Section headings */
  .article-section-heading {
    font-size: 1.3125rem;
    font-weight: 700;
    color: #edeae0;
    letter-spacing: -0.02em;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    font-family: var(--font-serif);
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
    line-height: 1.35;
  }

  /* Pull quote */
  .article-pullquote {
    margin: 2.25rem 0;
    padding: 1.25rem 1.5rem 1.25rem 1.625rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-card));
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: 1.175rem;
    font-style: italic;
    color: #e8e4da;
    line-height: 1.65;
    font-family: var(--font-serif);
    position: relative;
  }
  .article-pullquote::before {
    content: '\201C';
    position: absolute;
    top: -0.2rem;
    left: 1rem;
    font-size: 3rem;
    color: var(--accent);
    opacity: 0.35;
    font-family: var(--font-serif);
    line-height: 1;
    pointer-events: none;
  }

  /* Inline figure */
  .article-inline-figure {
    margin: 2rem 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }
  .article-inline-figure img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    display: block;
  }

  /* Tags */
  .article-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.875rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .tags-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }
  .tag-pill {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    padding: 3px 10px;
    border-radius: 20px;
    transition: color 0.15s, border-color 0.15s;
  }
  .tag-pill:hover { color: var(--text); border-color: var(--border); }

  /* AI Analysis */
  .ai-analysis-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.125rem 1.375rem;
    margin-bottom: 1.75rem;
  }
  .ai-analysis-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.625rem;
  }
  .ai-analysis-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.72;
    font-style: italic;
    margin: 0;
  }

  /* Source bar */
  .source-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
  }
  .source-bar-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.125rem;
  }
  .source-bar-name { font-size: 0.875rem; font-weight: 600; color: var(--text-secondary); }
  .source-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }
  .source-btn:hover { border-color: var(--text-muted); }

  /* Related section */
  .related-section { margin-top: 2.5rem; margin-bottom: 2rem; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .back-link { font-size: 0.875rem; color: var(--text-muted); transition: color 0.15s; }
  .back-link:hover { color: var(--text); }

  /* Sidebar */
  .article-sidebar { min-width: 0; }
  .sticky-sidebar { position: sticky; top: 72px; }

</style>
