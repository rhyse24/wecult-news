<style is:global>
  .hp-page { padding-bottom: 0; }

  /* ── Hero Grid ────────────────────────────── */
  .hp-hero-grid {
    display: grid;
    grid-template-columns: 1fr 288px;
    gap: 1.25rem;
    padding-top: 2rem;
    margin-bottom: 2.5rem;
    align-items: start;
    position: relative;
  }
  .hp-hero-grid::before {
    content: '';
    position: absolute;
    top: -60px; left: -10%; right: -10%;
    height: 220px;
    background: radial-gradient(ellipse at 50% 0%, rgba(201,168,76,0.07) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .hp-hero-main {
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .hp-hero-side {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border-subtle);
    padding-left: 1.25rem;
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .hp-hero-side .compact-card {
    padding: 0.875rem 0;
  }
  .hp-hero-side .compact-card:first-of-type {
    padding-top: 0.25rem;
  }
  .hs-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.7;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 15%, var(--border-subtle));
    margin-bottom: 0.125rem;
  }

  /* ── Ticker ───────────────────────────────── */
  .ticker-wrap {
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--accent) 12%, var(--border-subtle));
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 12%, var(--border-subtle));
    height: 32px;
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--accent) 3%, var(--bg));
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }
  .ticker-wrap:hover .ticker-inner { animation-play-state: paused; }
  .ticker-inner { display: flex; animation: ticker-scroll 40s linear infinite; white-space: nowrap; flex-shrink: 0; }
  .ticker-tag {
    font-size: 0.6875rem; font-weight: 600; color: var(--text-muted);
    padding: 0 1.375rem; transition: color 0.15s;
    display: inline-flex; align-items: center; gap: 0.625rem;
  }
  .ticker-tag:hover { color: var(--text-secondary); }
  .ticker-sep { color: var(--accent); font-size: 0.4375rem; opacity: 0.6; }
  @keyframes ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ── Body section wrapper ────────────────── */
  .hp-body-section {
    background: var(--bg);
    border-top: none;
    padding-top: 3rem;
    padding-bottom: 4.5rem;
    margin-top: 0;
    position: relative;
  }
  .hp-body-section::before {
    content: '';
    position: absolute;
    top: -40px; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .hp-body-fade {
    position: absolute; top: 0; left: 0; right: 0; height: 100px;
    background: linear-gradient(to bottom, rgba(201,168,76,0.04) 0%, transparent 100%);
    pointer-events: none; z-index: 2;
  }
  .section-header-left { display: flex; flex-direction: column; gap: 0.25rem; }
  .section-subtitle { font-size: 0.6875rem; color: var(--text-muted); font-weight: 400; letter-spacing: 0.01em; }
  .hp-body-section .section-title { font-size: 1rem; }

  /* ── Body grid ────────────────────────────── */
  .story-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .story-lead { grid-column: 1 / -1; }
  .story-lead .featured-card { min-height: 280px; max-height: 320px; border-radius: var(--radius-xl); }
  .story-lead .featured-img-wrap { width: 48%; }
  .story-lead .featured-title { font-size: 1.375rem; -webkit-line-clamp: 3; font-family: var(--font-serif); }
  .story-lead .featured-excerpt { -webkit-line-clamp: 3; font-size: 0.9375rem; }
  .story-grid > :nth-child(6) { grid-column: span 2; }
  .story-grid > :nth-child(6) .default-img-wrap { aspect-ratio: 21/9; }
  .story-count {
    font-size: 0.6875rem; font-weight: 600; color: var(--text-secondary);
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    padding: 2px 9px; border-radius: 20px;
  }
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }

  /* ── Mobile ───────────────────────────────── */
  @media (max-width: 768px) {
    .hp-hero-grid { grid-template-columns: 1fr !important; }

    /* Latest articles: horizontal scroll strip instead of vertical stack */
    .hp-hero-side {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      border-left: none;
      border-top: 1px solid var(--border-subtle);
      padding-left: 0;
      padding-top: 0.875rem;
      padding-bottom: 0.25rem;
      margin-top: 0.5rem;
      gap: 0.625rem;
    }
    .hp-hero-side::-webkit-scrollbar { display: none; }
    .hp-hero-side .compact-card {
      flex-shrink: 0;
      width: 210px;
      scroll-snap-align: start;
      border-bottom: none;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      background: var(--bg-card);
      padding: 0.625rem 0.75rem;
    }
    .hp-hero-side .compact-card:first-of-type { padding-top: 0.625rem; }

    .story-grid { grid-template-columns: 1fr !important; }
    .story-lead { grid-column: 1 / -1 !important; }
    .story-lead .featured-title { font-size: 1.125rem !important; }
    .story-grid > :nth-child(6) { grid-column: 1 / -1 !important; }
    .story-grid > :nth-child(6) .default-img-wrap { aspect-ratio: 16/9 !important; }
    .featured-card { flex-direction: column; max-height: none; }
    .featured-img-wrap { width: 100%; aspect-ratio: 16/9; }
  }
  @media (min-width: 480px) and (max-width: 768px) { .story-grid { grid-template-columns: 1fr 1fr !important; } }
  @media (min-width: 768px) and (max-width: 1024px) { .story-grid { grid-template-columns: repeat(3, 1fr) !important; } }
</style>
