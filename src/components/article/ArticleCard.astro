---
import type { Article, Lang } from '../../types'
import { t, getLocalizedPath } from '../../lib/i18n'
import { isBreaking, isFresh, isTrending } from '../../lib/articles'

interface Props {
  article: Article
  lang: Lang
  size?: 'hero' | 'featured' | 'default' | 'compact' | 'mini'
  eager?: boolean
}

const { article, lang, size = 'default', eager = false } = Astro.props

function buildSrcSet(url: string): string | undefined {
  if (!url) return undefined
  if (url.includes('wsrv.nl')) {
    const s400 = url.replace(/([?&]w=)\d+/, '$1400')
    const s700 = url.replace(/([?&]w=)\d+/, '$1700')
    return `${s400} 400w, ${s700} 700w, ${url} 900w`
  }
  if (url.includes('image.tmdb.org')) {
    const w342 = url.replace(/\/t\/p\/[a-z0-9]+\//, '/t/p/w342/')
    const w500 = url.replace(/\/t\/p\/[a-z0-9]+\//, '/t/p/w500/')
    const w780 = url.replace(/\/t\/p\/[a-z0-9]+\//, '/t/p/w780/')
    return `${w342} 342w, ${w500} 500w, ${w780} 780w`
  }
  return undefined
}

function buildAvifSrcSet(url: string): string | undefined {
  if (!url || !url.includes('wsrv.nl')) return undefined
  const avif = (u: string) => u.replace('output=webp', 'output=avif')
  const s400 = avif(url.replace(/([?&]w=)\d+/, '$1400'))
  const s700 = avif(url.replace(/([?&]w=)\d+/, '$1700'))
  return `${s400} 400w, ${s700} 700w, ${avif(url)} 900w`
}
const tr = article.translations[lang] ?? article.translations['en']

const catColor: Record<string, string> = {
  games: 'var(--cat-games)',
  film:  'var(--cat-film)',
  tv:    'var(--cat-tv)',
  books: 'var(--cat-books)',
}
const color = catColor[article.category]
const href = getLocalizedPath(lang, `/article/${article.slug}`)
const label = t(lang, `nav.${article.category}`)

const typeLabel: Record<string, string> = {
  news:    t(lang, 'article.type.news'),
  review:  t(lang, 'article.type.review'),
  feature: t(lang, 'article.type.feature'),
  opinion: t(lang, 'article.type.opinion'),
  guide:   t(lang, 'article.type.guide'),
}
const typeColor: Record<string, string> = {
  news: 'var(--text-muted)', review: '#f59e0b', feature: '#818cf8', opinion: '#f472b6', guide: '#34d399',
}

const breaking = isBreaking(article)
const fresh = isFresh(article)
const trending = !breaking && isTrending(article)

const listItems: string[] = (() => {
  if (article.article_type !== 'list') return []
  const body = tr?.body ?? ''
  const matches = [...body.matchAll(/^## \d+\.\s+(.+)$/gm)]
  return matches.map(m => m[1].trim())
})()

const timeAgo = (() => {
  const ms = Date.now() - new Date(article.published_at).getTime()
  const h = Math.floor(ms / 3600000)
  if (h < 1) return t(lang, 'ui.just_now')
  if (h < 24) return t(lang, 'ui.time_h', { h })
  const d = Math.floor(h / 24)
  return t(lang, 'ui.time_d', { d })
})()

const breakingLabel  = t(lang, 'ui.breaking')
const trendingLabel  = t(lang, 'ui.trending_badge')

const fallbackImages: Record<string, string> = {
  games: 'https://images.unsplash.com/photo-1552820728-8b83bb6b773f?w=900&q=80',
  film:  'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=900&q=80',
  tv:    'https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?w=900&q=80',
  books: 'https://images.unsplash.com/photo-1512820790803-83ca734da794?w=900&q=80',
}
const fallbackImg = fallbackImages[article.category] ?? fallbackImages.film
---

<!-- ─── Hero Card ─────────────────────────────────── -->
{size === 'hero' && (
  <a href={href} class="hero-card">
    <div class="hero-img-wrap">
      <div class="hero-img-placeholder" style={`background: color-mix(in srgb, ${color} 8%, var(--bg-card))`}></div>
      {article.cover_image && (
        <picture class="hero-picture">
          {buildAvifSrcSet(article.cover_image) && (
            <source
              type="image/avif"
              srcset={buildAvifSrcSet(article.cover_image)}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 65vw, 900px"
            />
          )}
          <img
            src={article.cover_image}
            srcset={buildSrcSet(article.cover_image)}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 65vw, 900px"
            alt={tr?.title}
            loading="eager"
            fetchpriority="high"
            data-fallback={fallbackImg}
            onerror="this.onerror=null;this.srcset='';this.closest('picture').querySelectorAll('source').forEach(s=>s.srcset='');this.src=this.dataset.fallback"
          />
        </picture>
      )}
      <div class="hero-gradient"></div>
    </div>
    <div class="hero-content">
      <div class="hero-tags">
        {breaking && <span class="breaking-badge">⬤ {breakingLabel}</span>}
        {trending && <span class="trending-badge">{trendingLabel}</span>}
        <span class="cat-pill" style={`--c:${color}`} aria-hidden="true"></span>
        <span class="type-badge" style={`color:${typeColor[article.article_type]}`}>{typeLabel[article.article_type]}</span>
      </div>
      <h2 class="hero-title">{tr?.title}</h2>
      {tr?.summary && <p class="hero-summary">{tr.summary}</p>}
      <div class="hero-meta">
        <span class="hero-source">{article.source_name}</span>
        <span class="hero-sep">·</span>
        <span class="hero-time">{timeAgo}</span>
        <span class="hero-sep">·</span>
        <span class="hero-read">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" style="opacity:.6" aria-hidden="true"><circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" stroke-width="1.2"/><path d="M5.5 3v2.5l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          {article.reading_time_minutes} min
        </span>
      </div>
    </div>
  </a>
)}

<!-- ─── Featured Card (wide horizontal) ──────────── -->
{size === 'featured' && (
  <a href={href} class="featured-card">
    <div class="featured-img-wrap">
      {article.cover_image
        ? <img src={article.cover_image} alt={tr?.title} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} data-fallback={fallbackImg} onerror="this.onerror=null;this.srcset='';this.src=this.dataset.fallback" />
        : <div class="featured-img-placeholder" style={`background:color-mix(in srgb, ${color} 8%, var(--bg-card))`}></div>
      }
      <span class="featured-cat-pill" style={`--c:${color}`} aria-hidden="true"></span>
      {breaking && <span class="breaking-overlay-badge">⬤ {breakingLabel}</span>}
      {trending && <span class="trending-overlay-badge">🔥</span>}
    </div>
    <div class="featured-body">
      <div class="default-type-row">
        <span class="type-badge" style={`color:${typeColor[article.article_type]}`}>{typeLabel[article.article_type]}</span>
        {fresh && !breaking && <span class="fresh-dot" title="Published recently"></span>}
      </div>
      <h2 class="featured-title">{tr?.title}</h2>
      {tr?.summary && <p class="featured-excerpt">{tr.summary}</p>}
      <div class="featured-footer">
        <span class="featured-read-time">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true"><circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" stroke-width="1.2"/><path d="M5.5 3v2.5l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          {article.reading_time_minutes} min
        </span>
        <span class="featured-meta">{article.source_name} · {timeAgo}</span>
      </div>
    </div>
  </a>
)}

<!-- ─── Default Card ──────────────────────────────── -->
{size === 'default' && (
  <a href={href} class="default-card" style={`--card-accent:${color}`}>
    <div class="default-img-wrap">
      {article.cover_image
        ? <img src={article.cover_image} alt={tr?.title} loading="lazy" data-fallback={fallbackImg} onerror="this.onerror=null;this.srcset='';this.src=this.dataset.fallback" />
        : <div class="default-img-placeholder" style={`background:color-mix(in srgb, ${color} 6%, var(--bg-card))`}></div>
      }
      <span class="default-cat-pill" style={`--c:${color}`} aria-hidden="true"></span>
      {breaking && <span class="breaking-overlay-badge">⬤ {breakingLabel}</span>}
      {trending && <span class="trending-overlay-badge">🔥</span>}
    </div>
    <div class="default-body">
      <div class="default-type-row">
        <span class="type-badge" style={`color:${typeColor[article.article_type]}`}>{typeLabel[article.article_type]}</span>
        {fresh && !breaking && <span class="fresh-dot" title="Published recently"></span>}
      </div>
      <h3 class="default-title">{tr?.title}</h3>
      {tr?.summary && <p class="default-excerpt">{tr.summary}</p>}
      <div class="default-footer">
        <span class="default-read-time">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true"><circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" stroke-width="1.2"/><path d="M5.5 3v2.5l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          {article.reading_time_minutes} min
        </span>
        <span class="default-meta">{article.source_name} · {timeAgo}</span>
      </div>
    </div>
  </a>
)}

<!-- ─── Compact Card ──────────────────────────────── -->
{size === 'compact' && (
  <a href={href} class="compact-card">
    {article.cover_image && (
      <div class="compact-img-wrap">
        <img src={article.cover_image} alt="" loading="lazy" data-fallback={fallbackImg} onerror="this.onerror=null;this.srcset='';this.src=this.dataset.fallback" />
      </div>
    )}
    <div class="compact-body">
      <div class="compact-meta-row">
        <span class="compact-cat" style={`color:${color}`}>{label}</span>
        {breaking && <span class="breaking-mini">{breakingLabel.toUpperCase()}</span>}
      </div>
      <h4 class="compact-title">{tr?.title}</h4>
      <span class="compact-time">
        {timeAgo} ·
        <svg width="10" height="10" viewBox="0 0 11 11" fill="none" style="display:inline;vertical-align:middle" aria-hidden="true"><circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" stroke-width="1.2"/><path d="M5.5 3v2.5l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        {article.reading_time_minutes} min
      </span>
    </div>
  </a>
)}

<!-- ─── Mini / Trending ───────────────────────────── -->
{size === 'mini' && (
  <a href={href} class="mini-card">
    <span class="mini-num"></span>
    <div class="mini-body">
      <span class="mini-cat" style={`color:${color}`}>{label}</span>
      <h4 class="mini-title">{tr?.title}</h4>
      <span class="mini-time">{timeAgo}</span>
    </div>
    {article.cover_image && (
      <div class="mini-thumb">
        <img src={article.cover_image} alt="" loading="lazy" data-fallback={fallbackImg} onerror="this.onerror=null;this.srcset='';this.src=this.dataset.fallback" />
      </div>
    )}
  </a>
)}

<!-- ─── List Card ────────────────────────────────── -->
{size === 'list' && (
  <a href={href} class="list-card" style={`--card-accent:${color}`}>
    <div class="list-img-wrap">
      {article.cover_image
        ? <img src={article.cover_image} alt={tr?.title} loading="lazy" data-fallback={fallbackImg} onerror="this.onerror=null;this.srcset='';this.src=this.dataset.fallback" />
        : <div class="list-img-placeholder" style={`background:color-mix(in srgb, ${color} 6%, var(--bg-card))`}></div>
      }
      <span class="list-cat-dot" style={`--c:${color}`} aria-hidden="true"></span>
      <span class="list-badge">LIST</span>
    </div>
    <div class="list-body">
      <h3 class="list-title">{tr?.title}</h3>
      {listItems.length > 0 && (
        <ol class="list-preview">
          {listItems.slice(0, 3).map((item) => (
            <li class="list-preview-item">{item}</li>
          ))}
        </ol>
      )}
      {listItems.length > 3 && (
        <span class="list-more">+{listItems.length - 3} more →</span>
      )}
      <div class="list-footer">
        <span class="list-meta">{article.source_name} · {timeAgo}</span>
      </div>
    </div>
  </a>
)}

<style is:global>
/* ─── Hero ─────────────────────────────────────── */
.hero-card {
  display: block;
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  aspect-ratio: 16/9;
  background: var(--bg-card);
}
.hero-img-wrap { position: absolute; inset: 0; }
.hero-picture { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
.hero-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.6s ease; }
.hero-card:hover .hero-img-wrap img { scale: 1.04; }

.hero-img-placeholder { width: 100%; height: 100%; }
.hero-gradient {
  position: absolute; inset: 0;
  background:
    linear-gradient(to top,
      rgba(0,0,0,0.97) 0%,
      rgba(0,0,0,0.65) 35%,
      rgba(0,0,0,0.18) 65%,
      rgba(0,0,0,0) 100%),
    linear-gradient(to right,
      rgba(0,0,0,0.3) 0%,
      transparent 45%);
}
.hero-content {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 2rem 1.875rem 1.625rem;
}
.hero-tags {
  display: flex; align-items: center; gap: 0.5rem;
  margin-bottom: 0.75rem;
}
.hero-title {
  font-size: clamp(1.375rem, 2.8vw, 1.875rem);
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -0.02em;
  color: #fff;
  margin-bottom: 0.5rem;
  text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  font-family: var(--font-serif);
}
.hero-summary {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.72);
  line-height: 1.55;
  margin-bottom: 1rem;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hero-meta {
  display: flex; align-items: center; gap: 0.375rem;
  font-size: 0.8125rem; color: rgba(255,255,255,0.58);
}
.hero-sep { opacity: 0.5; }
.hero-source {
  font-weight: 700;
  color: rgba(255,255,255,0.85);
  background: rgba(0,0,0,0.52);
  border: 1px solid rgba(255,255,255,0.15);
  padding: 2px 7px;
  border-radius: 4px;
  font-size: 0.75rem;
}
.hero-read { display: flex; align-items: center; gap: 3px; }

/* ─── Featured ─────────────────────────────────── */
.featured-card {
  display: flex;
  background: var(--bg-card);
  border: 1px solid color-mix(in srgb, var(--card-accent, var(--accent)) 18%, var(--border-subtle));
  border-left: 3px solid var(--card-accent, var(--accent));
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,0.5), 0 8px 28px rgba(0,0,0,0.3);
  transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  min-height: 180px;
  max-height: 210px;
}
.featured-card:hover {
  border-color: color-mix(in srgb, var(--card-accent, var(--accent)) 35%, var(--border));
  box-shadow:
    -8px 0 32px color-mix(in srgb, var(--card-accent, var(--accent)) 25%, transparent),
    0 12px 40px rgba(0,0,0,0.6),
    0 4px 16px rgba(0,0,0,0.35);
  transform: translateY(-2px);
}
.featured-img-wrap {
  position: relative;
  width: 42%;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--bg-raised);
}
.featured-img-wrap img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.35s ease;
}
.featured-card:hover .featured-img-wrap img { transform: scale(1.04); }
.featured-img-placeholder { width: 100%; height: 100%; }
.featured-cat-pill {
  position: absolute;
  top: 10px; left: 10px;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--c);
  box-shadow: 0 0 0 2px rgba(0,0,0,0.5);
}
.featured-body {
  flex: 1;
  padding: 1.25rem 1.375rem;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.featured-title {
  font-size: 1.125rem;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -0.02em;
  color: var(--text);
  margin-bottom: 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-excerpt {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
  margin-bottom: 1rem;
}
.featured-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border-subtle);
}
.featured-read-time { font-size: 0.75rem; color: var(--text-muted); }
.featured-meta { font-size: 0.75rem; color: var(--text-muted); }

/* ─── Default ──────────────────────────────────── */
.default-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--card-accent, var(--accent)) 12%, var(--border-subtle));
  box-shadow:
    0 0 0 0 transparent,
    0 2px 12px rgba(0,0,0,0.5),
    0 8px 32px rgba(0,0,0,0.35);
  transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  position: relative;
}
.default-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--card-accent, transparent);
  opacity: 0.35;
  transition: opacity 0.25s;
}
.default-card:hover {
  border-color: color-mix(in srgb, var(--card-accent, var(--accent)) 30%, var(--border));
  box-shadow:
    0 0 24px color-mix(in srgb, var(--card-accent, var(--accent)) 18%, transparent),
    0 8px 40px rgba(0,0,0,0.6),
    0 2px 12px rgba(0,0,0,0.4);
  transform: translateY(-3px);
}
.default-card:hover::after { opacity: 1; }
.default-img-wrap {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  background: var(--bg-raised);
}
.default-img-wrap img {
  width: 100%; height: 100%; object-fit: cover;
  transition: scale 0.5s ease;
}
.default-img-wrap::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 52px;
  background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
  pointer-events: none;
  z-index: 1;
}
.default-card:hover .default-img-wrap img { scale: 1.06; }
.default-img-placeholder { width: 100%; height: 100%; }
.default-cat-pill {
  position: absolute;
  bottom: 8px; left: 10px;
  z-index: 2;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--c);
  box-shadow: 0 0 0 2px rgba(0,0,0,0.45);
}
.default-body {
  padding: 1rem 1.125rem 1rem;
  display: flex; flex-direction: column; flex: 1;
  background: linear-gradient(to bottom, color-mix(in srgb, var(--card-accent, var(--accent)) 9%, var(--bg-card)) 0%, var(--bg-card) 55%);
}
.default-title {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.38;
  letter-spacing: -0.01em;
  color: var(--text);
  margin-bottom: 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.default-excerpt {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.58;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 0.875rem;
  flex: 1;
}
.default-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid color-mix(in srgb, var(--card-accent, var(--border-subtle)) 20%, var(--border-subtle));
}
.default-meta { font-size: 0.75rem; color: var(--text-secondary); }
.default-read-time { font-size: 0.75rem; color: var(--text-secondary); display: flex; align-items: center; gap: 3px; }
.featured-read-time { font-size: 0.75rem; color: var(--text-muted); display: flex; align-items: center; gap: 3px; }

/* ─── Compact ──────────────────────────────────── */
.compact-card {
  display: flex;
  gap: 0.75rem;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border-subtle);
  align-items: flex-start;
  transition: opacity 0.15s;
}
.compact-card:hover { opacity: 0.75; }
.compact-card:last-child { border-bottom: none; }
.compact-img-wrap {
  width: 76px; height: 52px;
  border-radius: var(--radius-sm);
  overflow: hidden; flex-shrink: 0;
  background: var(--bg-raised);
}
.compact-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.compact-body { flex: 1; min-width: 0; }
.compact-cat {
  font-size: 0.5625rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  display: block;
}
.compact-title {
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.38;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0.125rem 0 0.25rem;
